diff --git a/CMakeLists.orbis.txt b/CMakeLists.orbis.txt
new file mode 100644
index 00000000..3421ea1e
--- /dev/null
+++ b/CMakeLists.orbis.txt
@@ -0,0 +1,78 @@
+# KytyPS5 core for the PS4 (Orbis), stage 1: everything except graphics, the launcher and the parts
+# that need FFmpeg or SDL. Meant to be driven from the Orbis Eden tree:
+#
+#   cmake -S <folder that holds this file as CMakeLists.txt> -DKYTY_ROOT=<patched KytyPS5 checkout> \
+#         -DCMAKE_TOOLCHAIN_FILE=<eden-ps4.cmake> -DKYTY_EXTRA_DEPS=<xbyak/zydis/zstd checkouts>
+#
+# KYTY_ROOT must already have the EmuFive patches 0001-0005 and then 0100-orbis-port applied.
+# The toolchain file is the Orbis Eden one (toolchain/eden-ps4.cmake): it carries -D__ORBIS__,
+# -U__FreeBSD__, libc++ 18, emulated TLS and -march=btver2.
+cmake_minimum_required(VERSION 3.25)
+project(kyty_ps4 C CXX)
+
+set(KYTY_ROOT "${CMAKE_CURRENT_SOURCE_DIR}" CACHE PATH "the KytyPS5 checkout (patched)")
+set(CMAKE_CXX_STANDARD 20)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+set(KYTY_SOURCE_DIR "${KYTY_ROOT}/src")
+set(KYTY_3RD "${KYTY_ROOT}/3rdparty")
+set(KYTY_EXTRA_DEPS "" CACHE PATH "folder with xbyak/ zydis/ zstd/ checkouts (see README-ORBIS.md)")
+set(KYTY_FFMPEG_PREFIX "" CACHE PATH "FFmpeg for the PS4 (Orbis Eden's prefix/); empty = the FFmpeg-free subset")
+
+# ---- generated headers --------------------------------------------------------------------------
+set(GEN "${CMAKE_BINARY_DIR}/gen")
+file(MAKE_DIRECTORY "${GEN}")
+file(WRITE "${GEN}/cmake_config.h"
+"#define KYTY_VERSION \"0.0-orbis\"\n#define KYTY_BUILD_REPOSITORY \"\"\n#define KYTY_RELEASE_TAG \"\"\n"
+"#define KYTY_PLATFORM KYTY_PLATFORM_LINUX\n#define KYTY_COMPILER KYTY_COMPILER_CLANG\n"
+"#define KYTY_TOOLCHAIN \"clang-lld\"\n#define KYTY_BUILD KYTY_BUILD_RELEASE\n")
+configure_file("${KYTY_SOURCE_DIR}/kytyGitVersion.h.in" "${GEN}/kytyGitVersion.h" @ONLY)
+file(GLOB localization_catalogs CONFIGURE_DEPENDS "${KYTY_ROOT}/assets/localization/*.json")
+add_custom_command(OUTPUT "${GEN}/localizationData.h"
+	COMMAND ${CMAKE_COMMAND} "-DINPUTS=${localization_catalogs}" "-DOUTPUT=${GEN}/localizationData.h"
+		-P "${KYTY_SOURCE_DIR}/embed_localization.cmake"
+	DEPENDS ${localization_catalogs} "${KYTY_SOURCE_DIR}/embed_localization.cmake" VERBATIM)
+
+# ---- sources ------------------------------------------------------------------------------------
+file(GLOB common_src  CONFIGURE_DEPENDS "${KYTY_SOURCE_DIR}/common/*.cpp"
+	"${KYTY_SOURCE_DIR}/common/logging/*.cpp" "${KYTY_SOURCE_DIR}/common/platform/sysLinux*.cpp")
+file(GLOB kernel_src  CONFIGURE_DEPENDS "${KYTY_SOURCE_DIR}/kernel/*.cpp")
+file(GLOB loader_src  CONFIGURE_DEPENDS "${KYTY_SOURCE_DIR}/loader/*.cpp")
+file(GLOB libs_src    CONFIGURE_DEPENDS "${KYTY_SOURCE_DIR}/libs/*.cpp")
+list(FILTER common_src EXCLUDE REGEX "/sysWindows[^/]*$")
+# Left out of stage 1: SDL HID (replaced by the stub), FFmpeg users (until FFmpeg is rebuilt with
+# avformat/swresample/AAC/MP3 for the PS4), and the Tracy profiler (replaced by no-ops in the patch).
+set(KYTY_NEEDS_FFMPEG avPlayer libAudio libVideoDec2 libVdecsw videoDec2Decoder ajm)
+set(KYTY_DROP dualSenseHaptics dualSenseBluetooth)
+if(NOT KYTY_FFMPEG_PREFIX)
+	list(APPEND KYTY_DROP ${KYTY_NEEDS_FFMPEG} libFont libFontFt)
+endif()
+foreach(name IN LISTS KYTY_DROP)
+	list(FILTER libs_src EXCLUDE REGEX "/${name}\\.cpp$")
+endforeach()
+file(GLOB_RECURSE ajm_src CONFIGURE_DEPENDS "${KYTY_SOURCE_DIR}/libs/ajm/*.cpp")
+if(KYTY_FFMPEG_PREFIX)
+	list(APPEND libs_src ${ajm_src})
+endif()
+
+set(ORBIS_SHIM "${KYTY_ROOT}/orbis")
+add_library(kyty_core STATIC ${common_src} ${kernel_src} ${loader_src} ${libs_src}
+	"${ORBIS_SHIM}/sdl3_shim/sdl3_shim.cpp" "${ORBIS_SHIM}/stubs/dualSenseHaptics_orbis.cpp"
+	"${GEN}/localizationData.h")
+
+target_compile_definitions(kyty_core PUBLIC KYTY_ORBIS_STAGE1=1)
+target_compile_options(kyty_core PRIVATE -ferror-limit=0 -w
+	-include "${KYTY_SOURCE_DIR}/common/orbis/atomicRef.h")
+target_compile_options(kyty_core PUBLIC -fexperimental-library)
+target_include_directories(kyty_core PUBLIC
+	"${GEN}" "${KYTY_SOURCE_DIR}" "${ORBIS_SHIM}/sdl3_shim"
+	"${KYTY_3RD}/fmt/include" "${KYTY_3RD}/magic_enum/include" "${KYTY_3RD}/magic_enum/include/magic_enum"
+	"${KYTY_3RD}/spdlog/include" "${KYTY_3RD}/nlohmann_json/include" "${KYTY_3RD}/xxHash"
+	"${KYTY_3RD}/Vulkan-Headers/include" "${KYTY_3RD}/VulkanMemoryAllocator/include"
+	"${KYTY_3RD}/SPIRV-Headers/include" "${KYTY_3RD}/imgui" "${KYTY_3RD}/tracy/public"
+	"${KYTY_3RD}/stb" "${KYTY_3RD}/renderdoc" "${KYTY_3RD}/LibAtrac9/C/src"
+	"${KYTY_EXTRA_DEPS}/xbyak" "${KYTY_EXTRA_DEPS}/zydis/include"
+	"${KYTY_EXTRA_DEPS}/zydis/dependencies/zycore/include" "${KYTY_EXTRA_DEPS}/zstd/lib"
+	"${KYTY_EXTRA_DEPS}/zarchive/include" "${KYTY_EXTRA_DEPS}/opus/include" "${KYTY_3RD}/cpuinfo/include")
+if(KYTY_FFMPEG_PREFIX)
+	target_include_directories(kyty_core PUBLIC "${KYTY_FFMPEG_PREFIX}/include")
+endif()
diff --git a/orbis/sdl3_shim/SDL3/SDL.h b/orbis/sdl3_shim/SDL3/SDL.h
new file mode 100644
index 00000000..00df92ca
--- /dev/null
+++ b/orbis/sdl3_shim/SDL3/SDL.h
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// A small stand-in for the parts of SDL3 that KytyPS5's core libraries (libs/audio, controller,
+// libCes, libFont) use, built on the PS4's own services (sceAudioOut, libc iconv). There is no SDL3
+// for the PS4. Anything not listed here is not provided on purpose: the window, the launcher and
+// the DualSense code are replaced or left out on the Orbis build, not emulated.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+extern "C" {
+
+// ---- basics -----------------------------------------------------------------------------------
+typedef uint32_t SDL_InitFlags;
+inline constexpr SDL_InitFlags SDL_INIT_AUDIO   = 0x00000010u;
+inline constexpr SDL_InitFlags SDL_INIT_GAMEPAD = 0x00002000u;
+
+bool        SDL_InitSubSystem(SDL_InitFlags flags);
+void        SDL_QuitSubSystem(SDL_InitFlags flags);
+const char* SDL_GetError(void);
+void        SDL_free(void* mem);
+uint64_t    SDL_GetTicks(void);
+void        SDL_Delay(uint32_t ms);
+/// "/app0/": where the PS4 mounts the package contents.
+const char* SDL_GetBasePath(void);
+
+// ---- audio streams (sceAudioOut) ----------------------------------------------------------------
+typedef uint16_t SDL_AudioFormat;
+inline constexpr SDL_AudioFormat SDL_AUDIO_S16 = 0x8010; // signed 16-bit, little endian
+inline constexpr SDL_AudioFormat SDL_AUDIO_F32 = 0x8120; // 32-bit float, little endian
+typedef uint32_t SDL_AudioDeviceID;
+inline constexpr SDL_AudioDeviceID SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK = 0xFFFFFFFFu;
+
+struct SDL_AudioSpec {
+	SDL_AudioFormat format;
+	int             channels;
+	int             freq;
+};
+struct SDL_AudioStream; // opaque
+typedef void (*SDL_AudioStreamCallback)(void* userdata, SDL_AudioStream* stream, int additional_amount,
+                                        int total_amount);
+
+SDL_AudioStream*   SDL_OpenAudioDeviceStream(SDL_AudioDeviceID devid, const SDL_AudioSpec* spec,
+                                             SDL_AudioStreamCallback callback, void* userdata);
+void               SDL_DestroyAudioStream(SDL_AudioStream* stream);
+bool               SDL_ResumeAudioStreamDevice(SDL_AudioStream* stream);
+bool               SDL_PauseAudioStreamDevice(SDL_AudioStream* stream);
+bool               SDL_PutAudioStreamData(SDL_AudioStream* stream, const void* buf, int len);
+int                SDL_GetAudioStreamData(SDL_AudioStream* stream, void* buf, int len);
+int                SDL_GetAudioStreamQueued(SDL_AudioStream* stream);
+int                SDL_GetAudioStreamAvailable(SDL_AudioStream* stream);
+bool               SDL_ClearAudioStream(SDL_AudioStream* stream);
+SDL_AudioDeviceID  SDL_GetAudioStreamDevice(SDL_AudioStream* stream);
+bool               SDL_AudioDevicePaused(SDL_AudioDeviceID dev);
+/// The PS4 build has no audio capture: always an empty list.
+SDL_AudioDeviceID* SDL_GetAudioRecordingDevices(int* count);
+const char*        SDL_GetAudioDeviceName(SDL_AudioDeviceID devid);
+
+// ---- gamepads (the controller is read by the Orbis input layer, not through SDL) ----------------
+typedef uint32_t SDL_JoystickID;
+typedef uint32_t SDL_PropertiesID;
+struct SDL_Gamepad; // opaque; never created
+enum SDL_GamepadType { SDL_GAMEPAD_TYPE_UNKNOWN = 0, SDL_GAMEPAD_TYPE_STANDARD, SDL_GAMEPAD_TYPE_PS4, SDL_GAMEPAD_TYPE_PS5 };
+enum SDL_SensorType { SDL_SENSOR_INVALID = -1, SDL_SENSOR_UNKNOWN, SDL_SENSOR_ACCEL, SDL_SENSOR_GYRO };
+inline constexpr float SDL_STANDARD_GRAVITY = 9.80665f;
+#define SDL_PROP_GAMEPAD_CAP_MONO_LED_BOOLEAN "SDL.joystick.cap.mono_led"
+
+SDL_Gamepad*     SDL_GetGamepadFromID(SDL_JoystickID id);
+void             SDL_CloseGamepad(SDL_Gamepad* gamepad);
+SDL_GamepadType  SDL_GetGamepadType(SDL_Gamepad* gamepad);
+SDL_PropertiesID SDL_GetGamepadProperties(SDL_Gamepad* gamepad);
+bool             SDL_GetBooleanProperty(SDL_PropertiesID props, const char* name, bool default_value);
+bool             SDL_RumbleGamepad(SDL_Gamepad* gamepad, uint16_t low, uint16_t high, uint32_t ms);
+bool             SDL_SetGamepadLED(SDL_Gamepad* gamepad, uint8_t r, uint8_t g, uint8_t b);
+bool             SDL_SendGamepadEffect(SDL_Gamepad* gamepad, const void* data, int size);
+bool             SDL_GamepadHasSensor(SDL_Gamepad* gamepad, SDL_SensorType type);
+bool             SDL_SetGamepadSensorEnabled(SDL_Gamepad* gamepad, SDL_SensorType type, bool enabled);
+
+// ---- iconv (libCes): the PS4 libc has iconv ------------------------------------------------------
+typedef struct SDL_iconv_data_t* SDL_iconv_t;
+#define SDL_ICONV_ERROR  (static_cast<size_t>(-1))
+#define SDL_ICONV_E2BIG  (static_cast<size_t>(-2))
+#define SDL_ICONV_EILSEQ (static_cast<size_t>(-3))
+#define SDL_ICONV_EINVAL (static_cast<size_t>(-4))
+SDL_iconv_t SDL_iconv_open(const char* tocode, const char* fromcode);
+int         SDL_iconv_close(SDL_iconv_t cd);
+size_t      SDL_iconv(SDL_iconv_t cd, const char** inbuf, size_t* inbytesleft, char** outbuf,
+                      size_t* outbytesleft);
+
+} // extern "C"
