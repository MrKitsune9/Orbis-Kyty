set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_AR /usr/bin/llvm-ar)
set(CMAKE_RANLIB /usr/bin/llvm-ranlib)
set(CMAKE_C_COMPILER_TARGET x86_64-pc-freebsd12-elf)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-freebsd12-elf)
set(_c "-fPIC -funwind-tables -D__PS4__ -DPS4 -D__ORBIS__ -D_BSD_SOURCE=1 -D_GNU_SOURCE -U__FreeBSD__ -U__FreeBSD_cc_version -march=btver2 -O1 -nostdlibinc -isystem /tmp/claude-0/-home-claude/31221dcf-bef1-52cb-85d8-fcf5a736daa9/scratchpad/oo/musl/ps4/include -isystem /tmp/claude-0/-home-claude/31221dcf-bef1-52cb-85d8-fcf5a736daa9/scratchpad/oo/shim")
set(CMAKE_C_FLAGS_INIT "${_c}")
set(CMAKE_CXX_FLAGS_INIT "-nostdinc++ -isystem /tmp/claude-0/-home-claude/31221dcf-bef1-52cb-85d8-fcf5a736daa9/scratchpad/oo/cxxinst/include/c++/v1 ${_c} -fexceptions -frtti")
