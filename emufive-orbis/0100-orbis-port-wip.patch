diff --git a/src/common/orbis/atomicRef.h b/src/common/orbis/atomicRef.h
new file mode 100644
index 00000000..9f4227af
--- /dev/null
+++ b/src/common/orbis/atomicRef.h
@@ -0,0 +1,81 @@
+#ifndef KYTY_COMMON_ORBIS_ATOMIC_REF_H_
+#define KYTY_COMMON_ORBIS_ATOMIC_REF_H_
+
+// std::atomic_ref is C++20 but libc++ 18 (the newest one that builds with the PS4 toolchain here)
+// does not ship it. This is the subset KytyPS5 uses, built on the compiler's __atomic builtins.
+// Force-included for the Orbis build (-include), so it must not depend on any project header.
+
+#include <atomic>
+#include <cstddef>
+#include <type_traits>
+
+#if defined(__ORBIS__) && !defined(__cpp_lib_atomic_ref)
+namespace std { // NOLINT(cert-dcl58-cpp): polyfill for a missing standard class
+template <class T>
+class atomic_ref {
+public:
+	using value_type                        = T;
+	static constexpr bool is_always_lock_free = __atomic_always_lock_free(sizeof(T), 0);
+	static constexpr size_t required_alignment = sizeof(T) > alignof(T) ? sizeof(T) : alignof(T);
+
+	explicit atomic_ref(T& obj): m_ptr(&obj) {}
+	atomic_ref(const atomic_ref&) noexcept = default;
+	atomic_ref& operator=(const atomic_ref&) = delete;
+
+	T operator=(T desired) const noexcept { store(desired); return desired; }
+	operator T() const noexcept { return load(); }
+
+	bool is_lock_free() const noexcept { return __atomic_is_lock_free(sizeof(T), m_ptr); }
+
+	void store(T v, memory_order order = memory_order_seq_cst) const noexcept { __atomic_store(m_ptr, &v, static_cast<int>(order)); }
+	T load(memory_order order = memory_order_seq_cst) const noexcept
+	{
+		alignas(T) unsigned char buf[sizeof(T)];
+		__atomic_load(m_ptr, reinterpret_cast<T*>(buf), static_cast<int>(order));
+		return *reinterpret_cast<T*>(buf);
+	}
+	T exchange(T v, memory_order order = memory_order_seq_cst) const noexcept
+	{
+		alignas(T) unsigned char buf[sizeof(T)];
+		__atomic_exchange(m_ptr, &v, reinterpret_cast<T*>(buf), static_cast<int>(order));
+		return *reinterpret_cast<T*>(buf);
+	}
+	static constexpr memory_order FailureOrder(memory_order o) noexcept
+	{
+		return o == memory_order_acq_rel ? memory_order_acquire
+		       : o == memory_order_release ? memory_order_relaxed : o;
+	}
+	bool compare_exchange_weak(T& expected, T desired, memory_order success, memory_order failure) const noexcept
+	{
+		return __atomic_compare_exchange(m_ptr, &expected, &desired, true, static_cast<int>(success), static_cast<int>(failure));
+	}
+	bool compare_exchange_strong(T& expected, T desired, memory_order success, memory_order failure) const noexcept
+	{
+		return __atomic_compare_exchange(m_ptr, &expected, &desired, false, static_cast<int>(success), static_cast<int>(failure));
+	}
+	bool compare_exchange_weak(T& e, T d, memory_order s = memory_order_seq_cst) const noexcept
+	{ return compare_exchange_weak(e, d, s, FailureOrder(s)); }
+	bool compare_exchange_strong(T& e, T d, memory_order s = memory_order_seq_cst) const noexcept
+	{ return compare_exchange_strong(e, d, s, FailureOrder(s)); }
+
+	T fetch_add(T v, memory_order order = memory_order_seq_cst) const noexcept { return __atomic_fetch_add(m_ptr, v, static_cast<int>(order)); }
+	T fetch_sub(T v, memory_order order = memory_order_seq_cst) const noexcept { return __atomic_fetch_sub(m_ptr, v, static_cast<int>(order)); }
+	T fetch_and(T v, memory_order order = memory_order_seq_cst) const noexcept { return __atomic_fetch_and(m_ptr, v, static_cast<int>(order)); }
+	T fetch_or(T v, memory_order order = memory_order_seq_cst) const noexcept { return __atomic_fetch_or(m_ptr, v, static_cast<int>(order)); }
+	T fetch_xor(T v, memory_order order = memory_order_seq_cst) const noexcept { return __atomic_fetch_xor(m_ptr, v, static_cast<int>(order)); }
+	T operator++() const noexcept { return fetch_add(1) + 1; }
+	T operator++(int) const noexcept { return fetch_add(1); }
+	T operator--() const noexcept { return fetch_sub(1) - 1; }
+	T operator--(int) const noexcept { return fetch_sub(1); }
+	T operator+=(T v) const noexcept { return fetch_add(v) + v; }
+	T operator-=(T v) const noexcept { return fetch_sub(v) - v; }
+	T operator|=(T v) const noexcept { return fetch_or(v) | v; }
+	T operator&=(T v) const noexcept { return fetch_and(v) & v; }
+
+private:
+	T* m_ptr;
+};
+} // namespace std
+#endif
+
+#endif /* KYTY_COMMON_ORBIS_ATOMIC_REF_H_ */
